<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ContactApp.Desktop.AddEditContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add / Edit Contact" Height="320" Width="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Label Content="First:" Width="80" />
            <TextBox Width="260" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,6,0,0">
            <Label Content="Last:" Width="80" />
            <TextBox Width="260" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,6,0,0">
            <Label Content="Email:" Width="80" />
            <TextBox Width="260" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,6,0,0">
            <Label Content="Phone:" Width="80" />
            <TextBox Width="260" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0,6,0,0">
            <Label Content="Company:" Width="80" />
            <TextBox Width="260" Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,6,0,0">
            <Label Content="Notes:" />
            <TextBox Height="80" AcceptsReturn="True" Text="{Binding Notes}" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="90" Click="BtnOk_Click">OK</Button>
            <Button Width="90" Click="BtnCancel_Click">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>