<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ContactApp.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In" Height="240" Width="360" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Sign in to ContactApp" FontSize="16" FontWeight="Bold" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,10">
            <Label Content="Username:" />
            <TextBox x:Name="UsernameTextBox" />
            <Label Content="Password:" Margin="0,8,0,0" />
            <PasswordBox x:Name="PasswordBox" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="BtnLogin" Width="100" Click="BtnLogin_Click">Sign in</Button>
            <Button x:Name="BtnWindows" Width="170" Click="BtnWindows_Click">Use Windows Integrated Login</Button>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0" Foreground="Red" TextWrapping="Wrap" />
    </Grid>
</Window>
